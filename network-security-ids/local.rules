# Alert rules tracking enterprise perimeter anomalies
alert icmp any any -> $HOME_NET any (msg:"SECURITY ALERT: ICMP Flood / Unauthorized Ping Sweep Detected"; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"SECURITY ALERT: Unauthorized External SSH Bruteforce Attempt"; flags:S; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000002; rev:1;)
